{
  "appId": "com.outofboundsevents.scoring",
  "appName": "Out of Bounds",
  "webDir": "public",
  "server": {
    "url": "https://score.outofboundsevents.com/o/",
    "cleartext": false,
    "allowNavigation": [
      "accounts.google.com",
      "*.google.com",
      "appleid.apple.com",
      "*.apple.com",
      "ahutmswadskdkqhnrhhh.supabase.co",
      "*.supabase.co",
      "score.outofboundsevents.com"
    ]
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#10344E",
    "scheme": "Out of Bounds"
  },
  "android": {
    "backgroundColor": "#10344E"
  },
  "plugins": {
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#10344E"
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#10344E",
      "showSpinner": false,
      "androidSplashResourceName": "splash",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
